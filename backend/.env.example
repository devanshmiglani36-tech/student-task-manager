# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string (local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/studyflow

# JWT configuration (generate a strong random secret for production)
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS
# No trailing slashes! Exact origin match only.
# Local development:
CORS_ORIGIN=http://localhost:5173
# Production (Vercel) — set this in Render Environment Variables:
# CORS_ORIGIN=https://student-task-manager-8hke.vercel.app
